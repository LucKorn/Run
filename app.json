{
  "expo": {
    "name": "RUNNERGO",
    "slug": "runnergo",
    "version": "1.0.0",
    "owner": "lukorn",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A0F"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090A0F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ],
      "package": "com.lukorn.runnergo"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o RUNNERGO acesse sua localização para rastrear suas corridas mesmo em segundo plano."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4d763c5a-db3d-48f9-b105-da7cbd0c3ad1"
      }
    }
  }
}

